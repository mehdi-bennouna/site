---
import { ChevronRight } from "@lucide/astro";
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import ProjectLinks from "../../components/projects/project-links.astro";
import ProjectMeta from "../../components/projects/project-meta.astro";
import Base from "../../layouts/base.astro";
import { formatProject, getProjectEntries, type ProjectEntry } from "../../lib/project-data";
import "../../styles/blog.css";

// Only projects with a write-up get their own page.
export const getStaticPaths = (async () => {
	const entries = await getProjectEntries();
	return entries
		.filter((entry) => formatProject(entry).hasWriteup)
		.map((entry) => ({
			params: { slug: entry.id },
			props: { entry },
		}));
}) satisfies GetStaticPaths;

const { entry } = Astro.props as { entry: ProjectEntry };
const project = formatProject(entry);
const { Content } = await render(entry);
---

<Base title={project.title} description={project.description} ogImage={entry.data.ogImage}>
	<div id="main-content" class="flex-1">
		<div class="mx-auto w-full max-w-3xl px-5 py-10 sm:px-6 sm:py-14">
			<nav aria-label="Breadcrumb" class="mb-6 print:hidden">
				<ol class="flex flex-wrap items-center gap-1 text-xs text-muted-foreground">
					<li class="flex items-center gap-1">
						<a href="/" class="transition-colors hover:text-foreground">
							Home
						</a>
					</li>
					<li class="flex items-center gap-1">
						<ChevronRight size={12} class="opacity-60" aria-hidden="true" />
						<a href="/projects" class="transition-colors hover:text-foreground">
							Projects
						</a>
					</li>
					<li class="flex items-center gap-1">
						<ChevronRight size={12} class="opacity-60" aria-hidden="true" />
						<span aria-current="page" class="font-medium text-foreground">
							{project.title}
						</span>
					</li>
				</ol>
			</nav>

			<header class="flex flex-col gap-4">
				<div>
					<h1 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{project.title}</h1>
					<p class="mt-3 text-base leading-relaxed text-muted-foreground sm:text-lg">{project.description}</p>
				</div>
				<ProjectMeta status={project.status} tags={project.tags} />
				<ProjectLinks repo={project.repo} url={project.url} />
			</header>

			<article class="prose mt-8 max-w-none">
				<Content />
			</article>
		</div>
	</div>
</Base>
